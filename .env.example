# ── OathWatch environment ────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is git-ignored
# and must never be committed.

# Discord bot token.
# Create an application at https://discord.com/developers, add a bot user,
# and copy its token here. Invite the bot with the `bot` and
# `applications.commands` scopes, granting "Send Messages", "Embed Links",
# and "Read Message History" in every server you want it in.
DISCORD_TOKEN=your-discord-bot-token

# Hypixel API key.
# Obtain one at https://developer.hypixel.net by running /api in-game on
# the Hypixel network, then copy the key here.
HYPIXEL_API_KEY=your-hypixel-api-key

# ── Optional owner reporting channels ─────────────────────────────────────
# Leave blank to disable. These are optional — the bot runs without them.
#   Status channel: only 🟢 Bot Started / 🔄 Bot Restarted / 🔴 Bot Shutdown.
#   Log channel:    one operational summary per refresh cycle, plus setup,
#                   configuration changes, version information, and slow-refresh
#                   warnings (>10s per cycle).
#   Error channel:  failures with their traceback in a code block.
BOT_STATUS_CHANNEL_ID=
BOT_LOG_CHANNEL_ID=
BOT_ERROR_CHANNEL_ID=
